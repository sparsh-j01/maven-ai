{
  "name": "maven-ai",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "bootstrap": "cp -n .env.example .env; ln -sf ../../.env apps/web/.env; ln -sf ../../.env packages/db/.env",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "knip",
    "eval": "pnpm --filter @maven-ai/evals eval",
    "eval:sanity": "pnpm --filter @maven-ai/evals eval:sanity",
    "eval:live": "pnpm --filter @maven-ai/evals eval:live",
    "db:generate": "pnpm --filter @maven-ai/db generate",
    "db:migrate": "pnpm --filter @maven-ai/db migrate",
    "db:push": "pnpm --filter @maven-ai/db push"
  },
  "devDependencies": {
    "knip": "^6.26.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
