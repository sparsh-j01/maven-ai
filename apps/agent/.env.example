# Agent-only env. Copy to apps/agent/.env — gitignored, and NOT symlinked anywhere.
#
# You do NOT need this for local development: with no apps/agent/.env, the agent falls
# back to the repo-root .env (main.py), which is what `pnpm bootstrap` sets up.
#
# You DO need it to run the agent against production. The agent dials OUT to LiveKit,
# so it needs no public IP and no open port — it runs fine from a laptop against a
# deployed web app (the free hosting path). But that means putting the PRODUCTION
# DATABASE_URL in its env, and the root .env is symlinked into packages/db, where
# drizzle-kit reads it. Prod creds in the root .env = one absent-minded `pnpm db:push`
# rewrites the production schema. This file is the firewall.

# ── Database (prod Neon, for a shadow run) ─────────────────────
DATABASE_URL=

# ── Realtime transport (LiveKit) ───────────────────────────────
LIVEKIT_URL=                       # wss://…
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice + brain ──────────────────────────────────────────────
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# ── Code sandbox (Judge0) ──────────────────────────────────────
# Without JUDGE0_URL the coding round raises at coding.py — it fails loudly, on purpose.
JUDGE0_URL=                        # e.g. https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=              # optional — defaults to JUDGE0_URL's host
JUDGE0_AUTH_TOKEN=                 # optional — self-hosted Judge0 instead of RapidAPI

# ── Model overrides (optional; defaults in models.py) ──────────
AGENT_LLM_MODEL=                   # default gemini-2.5-flash
STT_MODEL=                         # default nova-3
TTS_MODEL=                         # default aura-asteria-en
