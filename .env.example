# Copy to .env and fill in. Never commit .env.

# ── Database (Neon Postgres + pgvector) ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maven_ai

# ── Auth (Clerk) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Realtime transport (LiveKit) ───────────────────────────────
LIVEKIT_URL=                       # wss://… — server + agent
NEXT_PUBLIC_LIVEKIT_URL=           # same value, exposed to the browser
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice providers (agent) ────────────────────────────────────
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# ── Code sandbox (Judge0) ──────────────────────────────────────
# Base URL of a Judge0 instance (the agent POSTs candidate code here to grade the
# coding round). Dev: point at a hosted Judge0 CE. Prod: self-host on Fly.
JUDGE0_URL=                        # e.g. http://localhost:2358 or a hosted CE
JUDGE0_AUTH_TOKEN=                 # optional — only if your instance requires X-Auth-Token

# ── Billing (Stripe test mode) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# ── Storage (Cloudflare R2) ────────────────────────────────────
# Résumé/audio object storage (S3-compatible). Résumé upload persistence is a
# no-op until these are set. R2_ENDPOINT is optional: leave blank for real R2
# (endpoint derived from R2_ACCOUNT_ID); set it to a local S3-compatible URL
# (MinIO/localstack) to exercise the storage path without R2 keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Rate limiting (Upstash Redis) ──────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Async jobs (Inngest) ───────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Observability ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
