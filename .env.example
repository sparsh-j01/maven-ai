# Copy to .env and fill in. Never commit .env.

# ── Database (Neon Postgres + pgvector) ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maven_ai

# ── Site ───────────────────────────────────────────────────────
# Canonical public origin. Only used to build absolute URLs for the OG/link-preview
# card (app/layout.tsx → metadataBase). Leave blank locally; on Vercel it falls back
# to the per-deployment VERCEL_URL, so set this in production to pin your real domain.
NEXT_PUBLIC_SITE_URL=""            # e.g. https://maven.example.com

# Public contact address — legal, privacy, security, refunds, account deletion.
# REQUIRED in production: `next build` throws if it's unset, so a deploy without it
# fails instead of shipping legal pages with no contact address. Local dev falls back
# to a placeholder. Use a role alias, not a personal inbox — GDPR and deletion requests
# need team visibility and an audit trail.
NEXT_PUBLIC_SUPPORT_EMAIL=""        # e.g. support@maven.example.com

# ── Auth (Clerk) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Admin ──────────────────────────────────────────────────────
# Comma-separated Clerk user ids who can approve interview requests (/admin).
# Find yours in the Clerk dashboard (Users → your account → User ID, "user_...").
ADMIN_USER_IDS=

# ── Realtime transport (LiveKit) ───────────────────────────────
LIVEKIT_URL=""                     # wss://… — server + agent
NEXT_PUBLIC_LIVEKIT_URL=""         # same value, exposed to the browser
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice providers (agent) ────────────────────────────────────
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# ── AI models (single source of truth) ─────────────────────────
# Swap any model by setting its var — no code change. Then prove it's good enough
# before shipping: `SCORER_MODEL=<new> pnpm eval` (see README → "Swapping a model").
# All optional; the defaults below are what ships. TS side: packages/shared/src/
# models.ts. Python agent: apps/agent/models.py (same env vars).
SCORER_MODEL=""                    # grades interviews + the eval (default gemini-2.5-flash)
SCORER_TEMPERATURE=""              # default 0 — scoring must be deterministic
PLAN_MODEL=""                      # personalizes the question plan (default gemini-2.5-flash)
RESUME_MODEL=""                    # structures résumé text (default gemini-2.5-flash)
AGENT_LLM_MODEL=""                 # interviewer brain (default gemini-2.5-flash)
STT_MODEL=""                       # speech-to-text (default nova-3)
TTS_MODEL=""                       # text-to-speech voice (default aura-asteria-en)

# ── Code sandbox (Judge0) ──────────────────────────────────────
# The agent POSTs candidate code here to grade the coding round. Cheapest launch
# path: hosted Judge0 CE on RapidAPI (free tier ≈ 50 calls/day — plenty, since
# interviews are admin-approved). Set JUDGE0_URL to the CE host + JUDGE0_RAPIDAPI_KEY.
# Self-hosting instead? Use JUDGE0_AUTH_TOKEN and leave the RapidAPI vars blank.
JUDGE0_URL=""                      # e.g. https://judge0-ce.p.rapidapi.com or http://localhost:2358
JUDGE0_RAPIDAPI_KEY=""             # RapidAPI key (hosted CE path)
JUDGE0_RAPIDAPI_HOST=""            # optional — defaults to JUDGE0_URL's host
JUDGE0_AUTH_TOKEN=""               # optional — self-hosted Judge0 X-Auth-Token instead

# ── Billing (Razorpay — the only gateway; test mode for now) ───
# Dashboard → Settings → API Keys → Generate (Test mode first). Create a monthly
# Plan at ₹799 (Subscriptions → Plans) and put its id (plan_...) below. Add a
# webhook (Settings → Webhooks) → https://<host>/api/webhooks/razorpay with the
# subscription.activated / .charged / .cancelled / .halted / .completed events,
# and use its signing secret as RAZORPAY_WEBHOOK_SECRET. Every region checks out
# via Razorpay (the ₹ plan) for now — see lib/razorpay.ts, billing.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_PRO=""            # monthly plan (₹799/mo)
RAZORPAY_PLAN_ID_PRO_ANNUAL=""    # annual plan (₹7,188/yr ≈ ₹599/mo); optional
RAZORPAY_WEBHOOK_SECRET=

# ── Storage (Cloudflare R2) ────────────────────────────────────
# Résumé/audio object storage (S3-compatible). Résumé upload persistence is a
# no-op until these are set. R2_ENDPOINT is optional: leave blank for real R2
# (endpoint derived from R2_ACCOUNT_ID); set it to a local S3-compatible URL
# (MinIO/localstack) to exercise the storage path without R2 keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Async jobs (Inngest) ───────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Observability ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=""         # app.posthog.com → Project settings → Project API Key
NEXT_PUBLIC_POSTHOG_HOST=""        # optional — defaults to https://us.i.posthog.com; EU: https://eu.i.posthog.com
