# Copy to .env and fill in. Never commit .env.

# ── Database (Neon Postgres + pgvector) ────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maven_ai

# ── Auth (Clerk) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Realtime transport (LiveKit) ───────────────────────────────
LIVEKIT_URL=                       # wss://… — server + agent
NEXT_PUBLIC_LIVEKIT_URL=           # same value, exposed to the browser
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Voice providers (agent) ────────────────────────────────────
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# ── Code sandbox (Judge0) ──────────────────────────────────────
# Base URL of a Judge0 instance (the agent POSTs candidate code here to grade the
# coding round). Dev: point at a hosted Judge0 CE. Prod: self-host on Fly.
JUDGE0_URL=                        # e.g. http://localhost:2358 or a hosted CE
JUDGE0_AUTH_TOKEN=                 # optional — only if your instance requires X-Auth-Token

# ── Billing (Stripe test mode) — US & rest of world ($) ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=          # monthly Pro price ($19/mo)
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=  # annual Pro price ($180/yr ≈ $15/mo); optional

# ── Billing (Razorpay) — India (₹799/mo Pro) ───────────────────
# Dashboard → Settings → API Keys → Generate (Test mode first). Create a monthly
# Plan at ₹799 (Subscriptions → Plans) and put its id (plan_...) below. Add a
# webhook (Settings → Webhooks) → https://<host>/api/webhooks/razorpay with the
# subscription.activated / .charged / .cancelled / .halted / .completed events,
# and use its signing secret as RAZORPAY_WEBHOOK_SECRET. Billing is region-routed:
# India → Razorpay, everyone else → Stripe (see lib/razorpay.ts, billing.ts).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_PRO=              # monthly plan (₹799/mo)
RAZORPAY_PLAN_ID_PRO_ANNUAL=      # annual plan (₹7,188/yr ≈ ₹599/mo); optional
RAZORPAY_WEBHOOK_SECRET=

# ── Storage (Cloudflare R2) ────────────────────────────────────
# Résumé/audio object storage (S3-compatible). Résumé upload persistence is a
# no-op until these are set. R2_ENDPOINT is optional: leave blank for real R2
# (endpoint derived from R2_ACCOUNT_ID); set it to a local S3-compatible URL
# (MinIO/localstack) to exercise the storage path without R2 keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Rate limiting (Upstash Redis) ──────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Async jobs (Inngest) ───────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Observability ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=           # app.posthog.com → Project settings → Project API Key
NEXT_PUBLIC_POSTHOG_HOST=          # optional — defaults to https://us.i.posthog.com; EU: https://eu.i.posthog.com
